    -- ── Métodos open/close/toggle ────────────────────────────
    function Window:Open()
        if self.IsOpen then return end
        self.IsOpen = true
        self.MainFrame.Visible = true
        self.UIScale.Scale = self.BaseScale * 0.92
        Tween(self.UIScale, {Scale = self.BaseScale}, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        self.FloatingButton.Visible = false
    end

    function Window:Close()
        if not self.IsOpen then return end
        self.IsOpen = false
        Tween(self.UIScale, {Scale = self.BaseScale * 0.92}, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.18, function()
            self.MainFrame.Visible = false
        end)
        self.FloatingButton.Visible = true
    end

    function Window:Toggle()
        if self.IsOpen then self:Close() else self:Open() end
    end

    -- ── Keybind global (RightShift padrão) ───────────────────
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == self.ToggleKey then
            self:Toggle()
        end
    end)

    -- ── Conexões de botões ───────────────────────────────────
    CloseBtn.MouseButton1Click:Connect(function() self:Close() end)
    MinBtn.MouseButton1Click:Connect(function() self:Close() end)
