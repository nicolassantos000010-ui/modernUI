            -- ═══════════════════════════════════════════════
            -- DROPDOWN (single + multi)
            -- ═══════════════════════════════════════════════
            function sectionObj:AddDropdown(c)
                c = c or {}
                local options = c.Options or {}
                local multi = c.Multi or false
                local selected = {}
                if multi then
                    for _, v in ipairs(c.Default or {}) do selected[v] = true end
                else
                    if c.Default then selected[c.Default] = true end
                end
                local isOpen = false

                local wrap = Create(sectionFrame, "Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    BackgroundTransparency = 1,
                    AutomaticSize = Enum.AutomaticSize.Y,
                    LayoutOrder = nextOrder(),
                })
                Create(wrap, "UIListLayout", {
                    Padding = UDim.new(0, 4),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                })

                local btn = Create(wrap, "TextButton", {
                    Text = "",
                    BackgroundColor3 = Theme.PanelLight,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 30),
                    AutoButtonColor = false,
                    LayoutOrder = 1,
                })
                Corner(btn, 6)
                Stroke(btn, Theme.Border, 1)

                local txt = Create(btn, "TextLabel", {
                    Text = "Selecione...",
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -40, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                })

                local arrow = Create(btn, "TextLabel", {
                    Text = "▼",
                    Font = Enum.Font.GothamBold,
                    TextSize = 10,
                    TextColor3 = Theme.Subtext,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -26, 0, 0),
                    TextXAlignment = Enum.TextXAlignment.Center,
                })

                local list = Create(wrap, "Frame", {
                    BackgroundColor3 = Theme.PanelLight,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 0),
                    ClipsDescendants = true,
                    LayoutOrder = 2,
                })
                Corner(list, 6)
                Stroke(list, Theme.Border, 1)

                local scroll = Create(list, "ScrollingFrame", {
                    Size = UDim2.new(1, -8, 1, -8),
                    Position = UDim2.new(0, 4, 0, 4),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollBarThickness = 2,
                })
                Create(scroll, "UIListLayout", {
                    Padding = UDim.new(0, 2),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                })

                local function updateLabel()
                    local count = 0
                    local first
                    for k in pairs(selected) do
                        count = count + 1
                        first = first or k
                    end
                    if count == 0 then
                        txt.Text = "Selecione..."
                    elseif count == 1 then
                        txt.Text = first
                    else
                        txt.Text = count .. " selecionados"
                    end
                end

                updateLabel()

                local optionBtns = {}
                for i, opt in ipairs(options) do
                    local ob = Create(scroll, "TextButton", {
                        Text = opt,
                        Font = Enum.Font.Gotham,
                        TextSize = 12,
                        TextColor3 = Theme.Text,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        BackgroundColor3 = selected[opt] and Theme.Accent or Theme.PanelLight,
                        BackgroundTransparency = selected[opt] and 0 or 1,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, 0, 0, 26),
                        AutoButtonColor = false,
                        LayoutOrder = i,
                    })
                    Corner(ob, 4)
                    Pad(ob, 0, 8, 0, 8)

                    ob.MouseEnter:Connect(function()
                        if not selected[opt] then
                            Tween(ob, {BackgroundTransparency = 0.5}, 0.1)
                        end
                    end)
                    ob.MouseLeave:Connect(function()
                        if not selected[opt] then
                            Tween(ob, {BackgroundTransparency = 1}, 0.1)
                        end
                    end)
                    ob.MouseButton1Click:Connect(function()
                        if multi then
                            selected[opt] = not selected[opt] or nil
                            Tween(ob, {BackgroundColor3 = selected[opt] and Theme.Accent or Theme.PanelLight,
                                       BackgroundTransparency = selected[opt] and 0 or 1}, 0.12)
                            updateLabel()
                            if c.Callback then
                                local arr = {}
                                for k in pairs(selected) do arr[#arr+1] = k end
                                task.spawn(c.Callback, arr)
                            end
                        else
                            for k in pairs(selected) do selected[k] = nil end
                            selected[opt] = true
                            for _, other in ipairs(optionBtns) do
                                Tween(other.btn, {BackgroundColor3 = Theme.PanelLight, BackgroundTransparency = 1}, 0.1)
                            end
                            Tween(ob, {BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0}, 0.12)
                            updateLabel()
                            if c.Callback then task.spawn(c.Callback, opt) end
                            task.delay(0.15, function()
                                if isOpen then
                                    isOpen = false
                                    Tween(list, {Size = UDim2.new(1, 0, 0, 0)}, 0.18)
                                    Tween(arrow, {Rotation = 0}, 0.18)
                                end
                            end)
                        end
                    end)
                    optionBtns[#optionBtns+1] = {btn = ob, value = opt}
                end

                btn.MouseButton1Click:Connect(function()
                    isOpen = not isOpen
                    if isOpen then
                        local h = math.min(#options * 28 + 8, 220)
                        Tween(list, {Size = UDim2.new(1, 0, 0, h)}, 0.22)
                        Tween(arrow, {Rotation = 180}, 0.22)
                    else
                        Tween(list, {Size = UDim2.new(1, 0, 0, 0)}, 0.18)
                        Tween(arrow, {Rotation = 0}, 0.18)
                    end
                end)

                local obj = {
                    Get = function() return multi and (function() local a={} for k in pairs(selected) do a[#a+1]=k end return a end)() or (next(selected)) end,
                    Set = function(v)
                        selected = {}
                        if type(v) == "table" then
                            for _, x in ipairs(v) do selected[x] = true end
                        elseif v then
                            selected[v] = true
                        end
                        updateLabel()
                    end,
                }
                sectionObj.Items[#sectionObj.Items+1] = obj
                return obj
            end

