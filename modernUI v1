    local ToggleKey    = cfg.ToggleKey or Enum.KeyCode.RightShift

    local Window = {
        Tabs = {},
        CurrentTab = nil,
        IsOpen = false,
        BaseScale = 1,
        ToggleKey = ToggleKey,
    }

    -- ── ScreenGui ────────────────────────────────────────────
    local ScreenGui = Create(UIParent, "ScreenGui", {
        Name = "ModernUI_Window",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = false,
    })
    Window.Gui = ScreenGui

    -- ── Main frame ───────────────────────────────────────────
    local Main = Create(ScreenGui, "Frame", {
        Name = "Main",
        Size = BaseSize,
        Position = UDim2.new(0.5, -BaseSize.X.Offset/2, 0.5, -BaseSize.Y.Offset/2),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Visible = false,
