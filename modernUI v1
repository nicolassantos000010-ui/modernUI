local function Notify(cfg)
    cfg = cfg or {}
    local title    = cfg.Title or "Notificação"
    local text     = cfg.Text or ""
    local duration = cfg.Duration or 4
    local ntype    = cfg.Type or "info"

    local color = Theme.Accent
    if ntype == "success" then color = Theme.Success
    elseif ntype == "warn" then color = Theme.Warning
    elseif ntype == "error" then color = Theme.Danger end

    local frame = Create(NotifHolder, "Frame", {
        Size = UDim2.new(1, 0, 0, 62),
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    })
    Corner(frame, 8)
    local stroke = Stroke(frame, Theme.Border, 1)
    stroke.Transparency = 1

    local bar = Create(frame, "Frame", {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
    })
    Corner(bar, 2)

    local titleLbl = Create(frame, "TextLabel", {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, -28, 0, 16),
        Position = UDim2.new(0, 20, 0, 10),
        TextTransparency = 1,
    })

    local textLbl = Create(frame, "TextLabel", {
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = Theme.Subtext,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Size = UDim2.new(1, -28, 0, 30),
        Position = UDim2.new(0, 20, 0, 28),
        TextTransparency = 1,
    })

    Tween(frame, {BackgroundTransparency = 0}, 0.25)
    Tween(stroke, {Transparency = 0}, 0.25)
    Tween(titleLbl, {TextTransparency = 0}, 0.25)
    Tween(textLbl, {TextTransparency = 0}, 0.25)

    task.delay(duration, function()
        Tween(frame, {BackgroundTransparency = 1}, 0.3)
        Tween(stroke, {Transparency = 1}, 0.3)
        Tween(titleLbl, {TextTransparency = 1}, 0.3)
        Tween(textLbl, {TextTransparency = 1}, 0.3)
        task.wait(0.3)
        frame:Destroy()
    end)
end

