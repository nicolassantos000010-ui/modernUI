    Corner(Main, 10)
    Stroke(Main, Theme.Border, 1)
    Window.MainFrame = Main

    local UIScaleInst = Create(Main, "UIScale", {Scale = 1})
    Window.UIScale = UIScaleInst

    -- ── Auto-scale ───────────────────────────────────────────
    local function UpdateScale()
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        local w, h = BaseSize.X.Offset, BaseSize.Y.Offset
        local s = 1
        if vp.X < w + 60 then s = math.min(s, (vp.X - 60) / w) end
        if vp.Y < h + 100 then s = math.min(s, (vp.Y - 100) / h) end
        Window.BaseScale = math.clamp(s, 0.45, 1)
        if Window.IsOpen then
            UIScaleInst.Scale = Window.BaseScale
        end
    end
    UpdateScale()
    Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)

