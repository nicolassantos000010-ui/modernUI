            -- ═══════════════════════════════════════════════
            function sectionObj:AddKeybind(c)
                c = c or {}
                local currentKey = c.Default or Enum.KeyCode.Q
                local listening = false
                local lastKey = currentKey

                local row = Create(sectionFrame, "Frame", {
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(),
                })

                Create(row, "TextLabel", {
                    Text = c.Name or "Keybind",
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -100, 1, 0),
                })

                local kbBtn = Create(row, "TextButton", {
                    Text = currentKey.Name,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 11,
                    TextColor3 = Theme.Text,
                    BackgroundColor3 = Theme.PanelLight,
                    BorderSizePixel = 0,
                    Size = UDim2.new(0, 90, 0, 26),
                    Position = UDim2.new(1, -90, 0.5, -13),
                    AutoButtonColor = false,
                })
                Corner(kbBtn, 6)
                local kStroke = Stroke(kbBtn, Theme.Border, 1)

                kbBtn.MouseButton1Click:Connect(function()
                    listening = true
                    kbBtn.Text = "..."
                    Tween(kStroke, {Color = Theme.Accent}, 0.15)
                end)

                local conn
                conn = UserInputService.InputBegan:Connect(function(input, processed)
                    if not listening then return end
                    if processed then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        listening = false
                        currentKey = input.KeyCode
                        kbBtn.Text = currentKey.Name
                        Tween(kStroke, {Color = Theme.Border}, 0.15)
                        if c.Callback then task.spawn(c.Callback, currentKey) end
                    end
                end)

                -- Detecção do keybind
                local checkConn = UserInputService.InputBegan:Connect(function(input, processed)
                    if processed then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard
                    and input.KeyCode == currentKey
                    and not listening then
                        if c.Callback then task.spawn(c.Callback, currentKey) end
                    end
                end)

                local obj = {
                    Get = function() return currentKey end,
                    Set = function(k)
                        currentKey = k
                        kbBtn.Text = k.Name
                    end,
                    Row = row,
                }
                sectionObj.Items[#sectionObj.Items+1] = obj
                return obj
            end

            -- ═══════════════════════════════════════════════
            -- COLORPICKER (HSV)
            -- ═══════════════════════════════════════════════
            function sectionObj:AddColorPicker(c)
                c = c or {}
                local h, s, v = RGBtoHSV(c.Default or Color3.fromRGB(99, 132, 255))
                local isOpen = false

                local wrap = Create(sectionFrame, "Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    BackgroundTransparency = 1,
                    AutomaticSize = Enum.AutomaticSize.Y,
                    LayoutOrder = nextOrder(),
                })
                Create(wrap, "UIListLayout", {
                    Padding = UDim.new(0, 4),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                })

                local btn = Create(wrap, "TextButton", {
                    Text = "",
                    BackgroundColor3 = Theme.PanelLight,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 30),
                    AutoButtonColor = false,
                    LayoutOrder = 1,
                })
                Corner(btn, 6)
                Stroke(btn, Theme.Border, 1)

                Create(btn, "TextLabel", {
                    Text = c.Name or "Color",
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -70, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                })

                local swatch = Create(btn, "Frame", {
                    BackgroundColor3 = HSVtoRGB(h, s, v),
                    BorderSizePixel = 0,
                    Size = UDim2.fromOffset(44, 20),
                    Position = UDim2.new(1, -54, 0.5, -10),
                })
                Corner(swatch, 4)
                Stroke(swatch, Theme.Border, 1)

                local panel = Create(wrap, "Frame", {
                    BackgroundColor3 = Theme.PanelLight,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 0),
                    ClipsDescendants = true,
                    LayoutOrder = 2,
                })
                Corner(panel, 6)
                Stroke(panel, Theme.Border, 1)
                Pad(panel, 8, 8, 8, 8)
                Create(panel, "UIListLayout", {
                    Padding = UDim.new(0, 6),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                })

                -- Preview grande
                local preview = Create(panel, "Frame", {
                    BackgroundColor3 = HSVtoRGB(h, s, v),
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 24),
                    LayoutOrder = 1,
                })
                Corner(preview, 4)

                local hexLbl = Create(panel, "TextLabel", {
                    Text = ToHex(HSVtoRGB(h, s, v)),
                    Font = Enum.Font.GothamMedium,
                    TextSize = 11,
                    TextColor3 = Theme.Text,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 16),
                    LayoutOrder = 2,
                })

                -- Helper para criar mini-slider de cor
                local function makeColorSlider(label, minV, maxV, initial, gradient, order)
                    local r = Create(panel, "Frame", {
                        Size = UDim2.new(1, 0, 0, 22),
                        BackgroundTransparency = 1,
                        LayoutOrder = order,
                    })
                    Create(r, "TextLabel", {
                        Text = label,
                        Font = Enum.Font.Gotham,
                        TextSize = 10,
                        TextColor3 = Theme.Subtext,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 0, 12),
                    })
                    local trk = Create(r, "Frame", {
                        Size = UDim2.new(1, 0, 0, 6),
                        Position = UDim2.new(0, 0, 0, 14),
                        BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0,
                    })
                    Corner(trk, 3)
                    if gradient then
                        Create(trk, "UIGradient", {Color = gradient})
                    end
                    local fill = Create(trk, "Frame", {
                        Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1,
                    })
                    local hnd = Create(trk, "Frame", {
                        Size = UDim2.fromOffset(10, 10),
                        Position = UDim2.new(0, -5, 0.5, -5),
                        BackgroundColor3 = Theme.Text,
                        BorderSizePixel = 0,
                        ZIndex = 3,
                    })
                    Corner(hnd, 5)
                    Stroke(hnd, Theme.Accent, 2)
                    local hitbox = Create(r, "Frame", {
                        Size = UDim2.new(1, 0, 0, 18),
                        Position = UDim2.new(0, 0, 0, 10),
                        BackgroundTransparency = 1,
                        ZIndex = 5,
                    })
                    local val = initial
                    local function setVal(x, silent)
                        val = math.clamp(x, minV, maxV)
                        local a = (val - minV) / math.max(maxV - minV, 1e-9)
                        hnd.Position = UDim2.new(a, -5, 0.5, -5)
                        if not silent then
                            -- callback externo
                        end
                    end
                    setVal(initial, true)
                    local drag = false
                    local function upd(pos)
                        local alpha = math.clamp((pos - trk.AbsolutePosition.X) / math.max(trk.AbsoluteSize.X, 1), 0, 1)
                        setVal(minV + (maxV - minV) * alpha)
                    end
                    hitbox.InputBegan:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                            drag = true; upd(i.Position.X)
                        end
                    end)
                    UserInputService.InputChanged:Connect(function(i)
                        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
                    end)
                    UserInputService.InputEnded:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
                    end)
                    return {Get = function() return val end}
                end

                local hueGrad = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255,0,0)),
                    ColorSequenceKeypoint.new(1/6, Color3.fromRGB(255,255,0)),
                    ColorSequenceKeypoint.new(2/6, Color3.fromRGB(0,255,0)),
                    ColorSequenceKeypoint.new(3/6, Color3.fromRGB(0,255,255)),
                    ColorSequenceKeypoint.new(4/6, Color3.fromRGB(0,0,255)),
                    ColorSequenceKeypoint.new(5/6, Color3.fromRGB(255,0,255)),
                    ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255,0,0)),
                })
                local hSlider = makeColorSlider("Hue", 0, 360, h, hueGrad, 3)
                local sSlider = makeColorSlider("Saturation", 0, 100, s, ColorSequence.new(Color3.new(1,1,1), HSVtoRGB(h,100,100)), 4)
                local vSlider = makeColorSlider("Value", 0, 100, v, ColorSequence.new(Color3.new(0,0,0), HSVtoRGB(h,100,100)), 5)

                local function updateColor()
                    h = hSlider.Get()
                    s = sSlider.Get()
                    v = vSlider.Get()
                    local col = HSVtoRGB(h, s, v)
                    swatch.BackgroundColor3 = col
                    preview.BackgroundColor3 = col
                    hexLbl.Text = ToHex(col)
                    if c.Callback then task.spawn(c.Callback, col) end
                end

                -- Usamos RunService para atualizar ao vivo
                RunService.Heartbeat:Connect(function()
                    if isOpen then updateColor() end
                end)

                btn.MouseButton1Click:Connect(function()
                    isOpen = not isOpen
                    if isOpen then
                        Tween(panel, {Size = UDim2.new(1, 0, 0, 200)}, 0.25)
                    else
                        Tween(panel, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
                    end
                end)

                local obj = {
                    Get = function() return HSVtoRGB(h, s, v) end,
                    Set = function(col)
                        h, s, v = RGBtoHSV(col)
                        hSlider = hSlider
                        updateColor()
                    end,
                }
                sectionObj.Items[#sectionObj.Items+1] = obj
                return obj
            end

            -- ═══════════════════════════════════════════════
            -- LABEL / DIVIDER / SPACE
            -- ═══════════════════════════════════════════════
            function sectionObj:AddLabel(text)
                local l = Create(sectionFrame, "TextLabel", {
                    Text = text or "",
                    Font = Enum.Font.Gotham,
                    TextSize = 11,
                    TextColor3 = Theme.Subtext,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 16),
                    LayoutOrder = nextOrder(),
                })
                sectionObj.Items[#sectionObj.Items+1] = {Frame = l}
                return l
            end

            function sectionObj:AddDivider()
                local d = Create(sectionFrame, "Frame", {
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Theme.Border,
                    BorderSizePixel = 0,
                    LayoutOrder = nextOrder(),
                })
                sectionObj.Items[#sectionObj.Items+1] = {Frame = d}
                return d
            end

            return sectionObj
        end

        Window.Tabs[#Window.Tabs+1] = tabObj
        if not Window.CurrentTab then
            Select()
        end

        return tabObj
    end

    -- ═══════════════════════════════════════════════════════
    -- SELECT TAB PÚBLICO
    -- ═══════════════════════════════════════════════════════
    function Window:SelectTab(name)
        for _, t in ipairs(self.Tabs) do
            if t.Name == name then
                t.Select()
                return true
            end
        end
        return false
    end

    -- Abre ao iniciar
    task.wait(0.05)
    Window:Open()

    UI.Windows[#UI.Windows+1] = Window
    return Window
end

