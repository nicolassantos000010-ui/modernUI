            Stroke(sectionFrame, Theme.Border, 1)
            Pad(sectionFrame, 10, 12, 12, 12)
            Create(sectionFrame, "UIListLayout", {
                Padding = UDim.new(0, 6),
                SortOrder = Enum.SortOrder.LayoutOrder,
            })

            if title then
                Create(sectionFrame, "TextLabel", {
                    Text = string.upper(title),
                    Font = Enum.Font.GothamBold,
                    TextSize = 10,
                    TextColor3 = Theme.Accent,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 14),
                    LayoutOrder = 0,
                })
            end

            sectionObj.Frame = sectionFrame
            tabObj.Sections[#tabObj.Sections+1] = sectionObj

            local function nextOrder() return #sectionObj.Items + 1 end

            -- ═══════════════════════════════════════════════
            -- TOGGLE
            -- ═══════════════════════════════════════════════
            function sectionObj:AddToggle(c)
                c = c or {}
                local state = c.Default or false
                local row = Create(sectionFrame, "Frame", {
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(),
                })

                Create(row, "TextLabel", {
                    Text = c.Name or "Toggle",
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -50, 1, 0),
                })

                local switch = Create(row, "Frame", {
                    Size = UDim2.fromOffset(36, 20),
                    Position = UDim2.new(1, -36, 0.5, -10),
                    BackgroundColor3 = state and Theme.Accent or Theme.PanelLight,
                    BorderSizePixel = 0,
                })
                Corner(switch, 10)

                local knob = Create(switch, "Frame", {
                    Size = UDim2.fromOffset(16, 16),
                    Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
                    BackgroundColor3 = Theme.Text,
                    BorderSizePixel = 0,
                })
                Corner(knob, 8)

                local lastTick = 0
                local function setState(v, silent)
                    state = v
                    Tween(switch, {BackgroundColor3 = state and Theme.Accent or Theme.PanelLight}, 0.2)
                    Tween(knob, {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}, 0.22, Enum.EasingStyle.Back)
                    if not silent and c.Callback then task.spawn(c.Callback, state) end
                end

                local function clickHandler(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        local now = os.clock()
                        if now - lastTick < 0.1 then return end
                        lastTick = now
                        setState(not state)
                    end
                end

                row.InputBegan:Connect(clickHandler)
                switch.InputBegan:Connect(clickHandler)

                local obj = { Set = setState, Get = function() return state end, Name = c.Name }
                sectionObj.Items[#sectionObj.Items+1] = obj
                if c.Default and c.Callback then task.spawn(c.Callback, state) end
                return obj
            end

            -- ═══════════════════════════════════════════════
            -- SLIDER
            -- ═══════════════════════════════════════════════
            function sectionObj:AddSlider(c)
                c = c or {}
                local mn = c.Min or 0
                local mx = c.Max or 100
                local dec = c.Decimals or 0
                local suffix = c.Suffix or ""
                local value = c.Default or mn

                local row = Create(sectionFrame, "Frame", {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(),
                })

                Create(row, "TextLabel", {
                    Text = c.Name or "Slider",
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -80, 0, 18),
                })

                local valLbl = Create(row, "TextLabel", {
                    Text = "",
                    Font = Enum.Font.GothamMedium,
                    TextSize = 11,
                    TextColor3 = Theme.Subtext,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0, 80, 0, 18),
                    Position = UDim2.new(1, -80, 0, 0),
                })

                local track = Create(row, "Frame", {
                    Size = UDim2.new(1, 0, 0, 4),
                    Position = UDim2.new(0, 0, 0, 28),
                    BackgroundColor3 = Theme.PanelLight,
                    BorderSizePixel = 0,
                    ZIndex = 1,
                })
                Corner(track, 2)

                local fill = Create(track, "Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0,
                    ZIndex = 1,
                })
                Corner(fill, 2)

                local handle = Create(track, "Frame", {
                    Size = UDim2.fromOffset(12, 12),
                    Position = UDim2.new(0, -6, 0.5, -6),
                    BackgroundColor3 = Theme.Text,
                    BorderSizePixel = 0,
                    ZIndex = 1,
                })
                Corner(handle, 6)
                Stroke(handle, Theme.Accent, 2)

                -- Hitbox invisível (por cima do visual)
                local hit = Create(row, "Frame", {
                    Size = UDim2.new(1, 0, 0, 22),
                    Position = UDim2.new(0, 0, 0, 20),
                    BackgroundTransparency = 1,
                    ZIndex = 5,
                })

                local function fmt(v)
                    if dec <= 0 then return tostring(math.floor(v + 0.5)) end
                    return string.format("%." .. dec .. "f", v)
                end

                local function apply(v, silent)
                    value = math.clamp(v, mn, mx)
                    local a = (value - mn) / math.max(mx - mn, 1e-9)
                    Tween(fill, {Size = UDim2.new(a, 0, 1, 0)}, 0.08)
                    Tween(handle, {Position = UDim2.new(a, -6, 0.5, -6)}, 0.08)
                    valLbl.Text = fmt(value) .. suffix
                    if not silent and c.Callback then task.spawn(c.Callback, value) end
                end

                apply(value, true)

                local dragging = false
                local function updateFromInput(pos)
                    local alpha = math.clamp((pos - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                    apply(mn + (mx - mn) * alpha)
                end

                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        updateFromInput(input.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch) then
                        updateFromInput(input.Position.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                local obj = { Set = apply, Get = function() return value end }
                sectionObj.Items[#sectionObj.Items+1] = obj
                return obj
            end

